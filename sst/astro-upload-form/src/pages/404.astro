---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found">
  <main>
    <h1>Page not found</h1>
    <p>This page doesn't exist. Head back to the <a href="/">upload form</a>.</p>
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding: 1.5rem;
    max-width: 60ch;
    color: white;
  }
  a {
    color: rgb(var(--accent-light));
  }
</style>
