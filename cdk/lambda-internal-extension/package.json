{
  "name": "cdk-lambda-internal-extension",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cdk": "cdk",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "diff": "cdk diff",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "synth": "cdk synth --strict",
    "test": "pnpm test:cdk && pnpm test:gate",
    "test:cdk": "node --import tsx --test \"test/*.test.ts\"",
    "test:gate": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src/layers/maintenance-window/python uv run --no-project --python 3.15 --with boto3==1.40.4 python -m unittest discover -s test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "aws-cdk": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
