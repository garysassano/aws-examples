{
  "name": "cdktn-nodejs-function-ts",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cdktn": "cdktn",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm synth",
    "deploy": "cdktn deploy --auto-approve",
    "destroy": "cdktn destroy --auto-approve",
    "diff": "cdktn diff",
    "format": "biome format --write .",
    "gen": "cdktn get",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "synth": "cdktn synth",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/functions/sample/tsconfig.json"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "catalog:",
    "@middy/core": "catalog:",
    "@middy/http-error-handler": "catalog:",
    "cdktn": "catalog:",
    "constructs": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "cdktn-cli": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
