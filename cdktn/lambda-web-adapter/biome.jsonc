{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": [
      "src/**",
      "!src/assets",
      "!src/functions/*/static",
      "!src/functions/*/src/assets",
      "test/**",
      "package.json",
      "cdktf.json",
      "vitest.config.ts"
    ]
  },
  "overrides": [
    {
      // Biome reads only the script block, so it cannot see what the markup uses.
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "useConst": "off"
          }
        }
      }
    }
  ]
}
